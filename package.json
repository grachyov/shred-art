{
  "name": "shred-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Letters, art, and an ending. The shred.art frontend.",
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "assets": "node scripts/generate-assets.mjs",
    "build": "vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "dry-run": "npm run check && wrangler deploy --dry-run --strict",
    "deploy": "npm run check && wrangler deploy --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grachyov/shred-art.git"
  },
  "homepage": "https://shred.art",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "opentype.js": "^1.3.4",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.9.6",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "4.154.0"
  }
}
